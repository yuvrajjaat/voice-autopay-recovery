# ---------------------------------------------------------------------------
# Voice Agent for Autopay Recovery — environment template
#
# Copy to `.env` and fill in your own values:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# PLACEHOLDERS ONLY. Never commit a real key, secret, or phone number.
# `.env` is gitignored. Every variable below is optional in Phase 0, so the
# app boots without any of them; later phases call settings.require(...) and
# fail with a clear message naming whatever is missing.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_PORT=8000
LOG_LEVEL=INFO

# --- ElevenLabs Agents (required from Phase 6) ------------------------------
# Create a key at https://elevenlabs.io  ->  Profile  ->  API Keys
ELEVENLABS_API_KEY=sk_replace_me
# Written for you by scripts/provision_agent.py; leave blank until then.
ELEVENLABS_AGENT_ID=
# Shared secret ElevenLabs uses to sign post-call webhooks (Phase 7).
ELEVENLABS_WEBHOOK_SECRET=wsec_replace_me

# --- Our own tool authentication (required from Phase 2) --------------------
# Any long random string. Sent by the agent as the X-Tool-Secret header and
# verified by the backend, because the tunnel below is publicly reachable.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_SHARED_SECRET=replace_with_a_random_string

# --- Public tunnel (required from Phase 6) ----------------------------------
# ElevenLabs' cloud calls our tools, so localhost must be publicly reachable.
# Use an ngrok static domain so the URL survives restarts.
PUBLIC_BASE_URL=https://your-static-domain.ngrok-free.app

# --- DIAL SAFETY -----------------------------------------------------------
# Every outbound call must pass app/dial_safety.py, which requires ALL of:
#   ENABLE_OUTBOUND_CALLS=true
#   DEMO_PHONE_NUMBER configured and valid E.164
#   the requested destination exactly equal to DEMO_PHONE_NUMBER
#   the customer not marked do-not-call
#
# Outbound telephony is OFF unless this is set to true by hand. Leave it
# false unless you are actively running the telephony demo.
ENABLE_OUTBOUND_CALLS=false
#
# The ONLY number this project is ever permitted to dial, in E.164 format
# (for example +14155550123). It must be a number you own or have explicit
# permission to call.
#
# Left EMPTY on purpose. A copied template therefore configures no dialable
# destination at all: the guard returns demo_number_not_configured until you
# fill this in yourself. Never commit a real number here.
DEMO_PHONE_NUMBER=

# --- Telephony (Phase 9 only; an identifier, NOT a credential) -------------
# The id of the number calls are placed FROM, returned by the voice provider
# after you import a Twilio number in their dashboard.
# NOTE: Twilio's Account SID and Auth Token are entered in the provider's
# dashboard, never here and never in this repository.
AGENT_PHONE_NUMBER_ID=

# --- Optional: offline text simulator (Phase 4) ----------------------------
# Only needed to run scripts/simulate.py. Consumes no ElevenLabs minutes.
ANTHROPIC_API_KEY=
